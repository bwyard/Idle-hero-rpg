{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@idle-hero-rpg/shared": ["../../packages/shared/src/index.ts"],
      "@prime/prime-random": ["./src/types/prime-random.d.ts"]
    }
  },
  "include": ["src/**/*", "app/**/*", "*.ts", "*.tsx"],
  "exclude": ["node_modules"]
}
