{
  "name": "@idle-hero-rpg/game",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=4096 eslint src --ext .ts,.tsx",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:unit": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest watch"
  },
  "dependencies": {
    "@idle-hero-rpg/shared": "*",
    "@prime/prime-random": "file:../../../prime/packages/prime-random",
    "@react-navigation/native": "^7.1.33",
    "expo": "~52.0.0",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-mmkv": "^3.1.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "^15.8.0",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/react": "~18.3.0",
    "@types/react-native": "~0.73.0",
    "cross-env": "^10.1.0",
    "fast-check": "^3.19.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  }
}
